students = [
    ("Asha", 85), ("Rahul", 90), ("Priya", 78),
    ("Arun", 88), ("Neha", 92), ("Kiran", 80)
]

# Form teams of 2
teams = [students[i:i+2] for i in range(0, len(students), 2)]

# Rank teams by average score
teams.sort(key=lambda t: sum(s[1] for s in t) / len(t), reverse=True)

# Display results
for rank, team in enumerate(teams, 1):
    names = ", ".join(s[0] for s in team)
    score = sum(s[1] for s in team) / len(team)
    print(f"Rank {rank}: {names} | Score: {score:.1f}")