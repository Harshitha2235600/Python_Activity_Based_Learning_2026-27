
name = input("Passenger name: ")
age = int(input("Enter age: "))
seats = int(input("Number of seats: "))
fare = float(input("Fare per seat: ₹"))
total = seats * fare
if age < 5:
    total = 0
elif age >= 60:
    total *= 0.8
print("\n--- Ticket Details ---")
print("Name:", name)
print("Age:", age)
print("Seats:", seats)
print("Total Fare: ₹", total)
print("Reservation Successful!")
