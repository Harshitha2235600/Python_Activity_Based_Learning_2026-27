capacity = int(input("Bus capacity: "))
passengers = 0
while True:
    print("\n1. Board  2. Exit  3. Status  4. Quit")
    choice = input("Choose: ")
    if choice == "1":
        if passengers < capacity:
            passengers += 1
            print("Passenger boarded.")
        else:
            print("Bus is full!")
    elif choice == "2":
        if passengers > 0:
            passengers -= 1
            print("Passenger exited.")
        else:
            print("Bus is empty!")
    elif choice == "3":
        print("Passengers:", passengers)
        print("Available seats:", capacity - passengers)
    elif choice == "4":
        break
    else:
        print("Invalid choice!")

